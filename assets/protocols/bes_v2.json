  "atCommands": [
    { "command": "AT+VERSION?",  "responsePrefix": "+VERSION:", "description": "查询固件版本" },
    { "command": "AT+BATTERY?",  "responsePrefix": "+BATTERY:", "description": "查询电池电量" },
    { "command": "AT+ANC=ON",    "description": "开启主动降噪" },
    { "command": "AT+ANC=OFF",   "description": "关闭主动降噪" },
    { "command": "AT+TWS_PAIR",  "description": "TWS配对" },
