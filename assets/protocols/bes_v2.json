    { "command": "AT+LED=ON",    "description": "LED 开" },
    { "command": "AT+LED=OFF",   "description": "LED 关" },
    { "command": "AT+RESET",     "description": "设备复位" },
    { "command": "AT+OTA_BEGIN", "description": "开始OTA升级" }
