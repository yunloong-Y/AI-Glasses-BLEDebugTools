          "notifyPayloadFormat": "frame:bes_a5"
        },
        {
          "name": "WRITE_TX (手机→设备)",
          "uuid": "03000300-0000-2000-8000-009278563412",
          "direction": "write",
          "writePayloadFormat": "frame:bes_a5"
        }
      ]
    },
