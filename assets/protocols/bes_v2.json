  "frameFormats": [
    {
      "name": "bes_a5",
      "description": "BES BLE 0xA5 外层帧（主数据通道）",
      "magicByte": 165,
      "checksumType": "crc16_ibm",
      "checksumOffset": 3,
      "checksumLength": 2,
      "crcPoly": 40961,
      "crcInit": 0,
      "crcReflect": true,
      "fields": [
        { "name": "magic", "encoding": "uint8", "byteLength": 1, "description": "帧头 0xA5", "enumMap": { "165": "A5帧头" } },
        { "name": "payloadLength", "encoding": "uint16", "endian": "little", "byteLength": 2, "description": "Payload长度 (不含A5/Len/CRC)" },
        { "name": "payload", "encoding": "bytes", "lengthSource": "payloadLength", "description": "内层 payload (CMD+Type+Seq+DataLen+Data)" },
        { "name": "crc16", "encoding": "uint16", "endian": "little", "byteLength": 2, "description": "CRC-16/IBM (覆盖A5+Len+Payload)" }
      ]
    },
    {
      "name": "bes_inner_payload",
      "description": "BES BLE 内层 payload 结构",
      "fields": [
        { "name": "cmd", "encoding": "uint16", "endian": "little", "byteLength": 2, "description": "命令ID" },
        { "name": "type", "encoding": "uint8", "byteLength": 1, "description": "帧类型", "enumMap": { "1": "请求(Request)", "2": "响应(Response)", "3": "通知(Notification)" } },
        { "name": "seq", "encoding": "uint8", "byteLength": 1, "description": "序列号 (递增)" },
        { "name": "dataLen", "encoding": "uint16", "endian": "little", "byteLength": 2, "description": "数据长度" },
        { "name": "data", "encoding": "bytes", "lengthSource": "dataLen", "description": "业务数据" }
      ]
    },
    {
      "name": "bes_commandset",
      "description": "BES CommandSet 帧 (设备控制)",
      "magicBytes": [8, 99],
      "fields": [
        { "name": "magic", "encoding": "uint16", "endian": "big", "byteLength": 2, "description": "0x08 0x63" },
        { "name": "length", "encoding": "uint32", "endian": "little", "byteLength": 4, "description": "数据长度" },
        { "name": "cmdType", "encoding": "uint8", "byteLength": 1, "description": "命令类型" },
        { "name": "data", "encoding": "bytes", "lengthSource": "length", "description": "命令数据" }
      ]
    },
    {
      "name": "bes_commandset_crc",
      "description": "BES CommandSet CRC 帧 (带校验)",
      "magicBytes": [16, 99],
      "fields": [
        { "name": "magic", "encoding": "uint16", "endian": "big", "byteLength": 2, "description": "0x10 0x63" },
        { "name": "magicCode", "encoding": "ascii", "byteLength": 4, "description": "\"BEST\" 魔术码" },
        { "name": "data", "encoding": "bytes", "description": "CRC数据" }
      ]
    },
    {
      "name": "bes_ota",
      "description": "BES OTA 协议命令",
      "fields": [
        { "name": "cmd", "encoding": "uint8", "byteLength": 1, "description": "OTA子命令" },
        { "name": "data", "encoding": "bytes", "description": "OTA数据" }
      ]
    }
  ],
