{
  "id": "bes_v2",
  "name": "恒玄 BES2700 AI眼镜 BLE协议",
  "vendor": {
    "vendorName": "Bestechnic (恒玄科技)",
    "chipSeries": "BES2700 / BES2600 系列",
    "protocolVersion": "v2.0.17",
    "website": "https://www.bestechnic.com",
    "description": "恒玄 BES2700 系列是用于 AI 智能眼镜/蓝牙耳机的超低功耗蓝牙音频 SoC。采用双核 STAR-MC1 + BECO NPU，支持蓝牙 5.4 双模。协议层使用自定义 0xA5 帧格式，内部封装 CMD+Type+Data 结构，CRC-16/IBM 校验。"
  },
  "services": [
    {
