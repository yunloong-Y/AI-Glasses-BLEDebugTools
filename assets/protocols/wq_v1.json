      "magicBytes": [208, 210, 197, 194],
      "checksumType": "crc32",
      "checksumOffset": -1,
      "checksumLength": 4,
      "fields": [
        { "name": "magic",    "encoding": "hex", "byteLength": 4, "description": "魔术字 0xD0 0xD2 0xC5 0xC2" },
        { "name": "version",  "encoding": "uint8", "byteLength": 1, "description": "协议版本" },
        { "name": "length",   "encoding": "uint16", "endian": "big", "byteLength": 2, "description": "数据长度" },
        { "name": "msgType",  "encoding": "uint8", "byteLength": 1, "description": "消息类型", "enumMap": { "1": "请求", "2": "响应", "3": "通知" } },
        { "name": "tid",      "encoding": "uint8", "byteLength": 1, "description": "事务ID" },
        { "name": "seqnum",   "encoding": "uint16", "endian": "big", "byteLength": 2, "description": "序列号" },
        { "name": "crc8",     "encoding": "uint8", "byteLength": 1, "description": "头部CRC8" },
        { "name": "payload",  "encoding": "bytes", "lengthSource": "length", "description": "CLI消息体" },
        { "name": "crc32",    "encoding": "uint32", "endian": "big", "byteLength": 4, "description": "验证CRC32" }
      ]
    },
    {
      "name": "wq_cli_inner",
      "description": "WQ CLI 内层消息帧",
      "fields": [
        { "name": "start",    "encoding": "uint16", "endian": "big", "byteLength": 2, "description": "起始 0x2323" },
        { "name": "moduleId", "encoding": "uint16", "endian": "big", "byteLength": 2, "description": "模块ID", "enumMap": { "4": "Common", "5": "LOWPOWER", "6": "Application", "8": "AudioParam" } },
        { "name": "crc16",    "encoding": "uint16", "endian": "big", "byteLength": 2, "description": "内层CRC16" },
        { "name": "msgId",    "encoding": "uint16", "endian": "big", "byteLength": 2, "description": "消息ID" },
        { "name": "reserved", "encoding": "uint16", "endian": "big", "byteLength": 2, "description": "保留字段" },
        { "name": "length",   "encoding": "uint16", "endian": "big", "byteLength": 2, "description": "数据长度" },
        { "name": "seq",      "encoding": "uint16", "endian": "big", "byteLength": 2, "description": "序列号" },
        { "name": "data",     "encoding": "bytes", "lengthSource": "length", "description": "消息数据" },
        { "name": "end",      "encoding": "uint16", "endian": "big", "byteLength": 2, "description": "结束 0x4040" }
      ]
    },
    {
      "name": "wq_audio",
      "description": "WQ Audio 协议帧 (音频流控制)",
      "magicBytes": [81, 87],
      "fields": [
        { "name": "syncWord",  "encoding": "uint16", "endian": "big", "byteLength": 2, "description": "同步字 0x51 0x57" },
        { "name": "checksum",  "encoding": "uint8", "byteLength": 1, "description": "校验和" },
        { "name": "reserved",  "encoding": "uint8", "byteLength": 1, "description": "保留" },
        { "name": "flags",     "encoding": "uint8", "byteLength": 1, "description": "标志位 (proto_ver 4b + need_ack 1b + frame_type 3b)" },
        { "name": "seqNumber", "encoding": "uint8", "byteLength": 1, "description": "序列号" },
        { "name": "svcType",   "encoding": "uint8", "byteLength": 1, "description": "服务类型", "enumMap": { "0": "Common", "1": "PlayAudio", "2": "Record", "3": "RecordOnly", "4": "VAD" } },
        { "name": "cmdId",     "encoding": "uint8", "byteLength": 1, "description": "命令ID" },
        { "name": "payloadLen","encoding": "uint16", "endian": "little", "byteLength": 2, "description": "Payload长度" },
        { "name": "body",      "encoding": "bytes", "lengthSource": "payloadLen", "description": "音频数据/命令体" }
      ]
    }
  ],
