  "frameFormats": [
    {
      "name": "wq_ota",
      "description": "WQ OTA 协议帧 (固件升级)",
      "magicBytes": [112, 7, 110],
      "checksumType": "none",
      "fields": [
        { "name": "magic",    "encoding": "hex", "byteLength": 3, "description": "魔术字 0x70 0x07 0x6E" },
        { "name": "header",   "encoding": "uint8", "byteLength": 1, "description": "帧头 0xC0", "enumMap": { "192": "请求帧" } },
        { "name": "opCode",   "encoding": "uint8", "byteLength": 1, "description": "操作码" },
        { "name": "length",   "encoding": "uint16", "endian": "big", "byteLength": 2, "description": "Payload长度" },
        { "name": "seq",      "encoding": "uint8", "byteLength": 1, "description": "序列号" },
        { "name": "payload",  "encoding": "bytes", "lengthSource": "length", "description": "业务数据" },
        { "name": "suffix",   "encoding": "uint8", "byteLength": 1, "description": "帧尾 0x33", "enumMap": { "51": "帧尾" } }
      ]
    },
    {
      "name": "wq_cli",
