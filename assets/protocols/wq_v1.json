{
  "id": "wq_v1",
  "name": "物奇微 WQ7036 AI眼镜 BLE协议",
  "vendor": {
    "vendorName": "WUQI Micro (物奇微)",
    "chipSeries": "WQ7036 / WQ703X 系列",
    "protocolVersion": "v1.0.0",
    "website": "https://www.wqcore.com",
    "description": "WQ7036 是物奇微高端蓝牙音频 SoC，内置 HiFi 5 DSP + NPU，支持蓝牙 5.3/5.4 双模、LE Audio、LC3 编解码、Hybrid ANC。已批量应用于华为 FreeBuds/智能眼镜、荣耀、OPPO、JBL 等品牌。BLE 协议采用 7033/7034 段 UUID，支持 OTA/CLI/Audio 三种独立协议层，每个协议层有独立的帧格式和校验机制。"
  },
  "services": [
    {
      "name": "WQ BLE OTA Service",
      "uuid": "00007033-0000-1000-8000-00805F9B34FB",
      "description": "7033 段 BLE 数据通道 (OTA + 主数据通信)，用于固件升级和应用层数据传输",
      "characteristics": [
        {
          "name": "BLE_WRITE (手机→设备)",
          "uuid": "00002001-0000-1000-8000-00805F9B34FB",
          "direction": "write",
          "writePayloadFormat": "frame:wq_ota",
          "description": "OTA 命令写入 (QueryDeviceInfo/EnterUpgrade/SendFile 等)"
        },
        {
          "name": "BLE_NOTIFY (设备→手机)",
          "uuid": "00002002-0000-1000-8000-00805F9B34FB",
          "direction": "notify",
          "notifyPayloadFormat": "frame:wq_ota",
          "description": "OTA 状态通知与响应"
        }
      ]
    },
    {
