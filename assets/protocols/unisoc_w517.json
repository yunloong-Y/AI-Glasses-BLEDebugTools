  "frameFormats": [
    {
      "name": "unisoc_cmd",
      "description": "展锐 JSON-RPC 命令帧。Android系统层使用JSON-RPC over BLE封装应用层命令",
      "endian": "little",
      "fields": [
        {
          "name": "start",
          "encoding": "hex",
          "byteLength": 1,
          "value": "0xF1",
          "description": "帧头标识"
        },
        {
          "name": "msgId",
          "encoding": "uint8",
          "byteLength": 1,
          "description": "消息ID，用于匹配请求-响应对"
        },
        {
          "name": "type",
          "encoding": "uint8",
          "byteLength": 1,
          "description": "消息类型",
          "enumMap": {
            "0": "REQUEST",
            "1": "RESPONSE",
            "2": "NOTIFY",
            "3": "ERROR"
          }
        },
        {
          "name": "module",
          "encoding": "uint8",
          "byteLength": 1,
          "description": "功能模块",
          "enumMap": {
            "0x01": "SYSTEM",
            "0x02": "CAMERA",
            "0x03": "AUDIO",
            "0x04": "DISPLAY",
            "0x05": "SENSOR",
            "0x06": "AI",
            "0x07": "NETWORK",
            "0x08": "OTA",
            "0x09": "FILE",
            "0x0A": "POWER"
          }
        },
        {
          "name": "cmdId",
          "encoding": "uint16",
          "byteLength": 2,
          "endian": "little",
          "description": "命令ID"
        },
        {
          "name": "payloadLen",
          "encoding": "uint16",
          "byteLength": 2,
          "endian": "little",
          "description": "payload字节数"
        },
        {
          "name": "payload",
          "encoding": "bytes",
          "byteLength": 0,
          "lengthSource": "payloadLen",
          "description": "JSON字符串payload (UTF-8编码)"
        },
        {
          "name": "crc16",
          "encoding": "uint16",
          "byteLength": 2,
          "endian": "little",
          "description": "CRC-16/CCITT 校验 (从start到payload末尾)"
        },
        {
          "name": "end",
          "encoding": "hex",
          "byteLength": 1,
          "value": "0xF2",
          "description": "帧尾标识"
        }
      ],
      "checksum": {
        "type": "crc16_ccitt",
        "startField": "start",
        "endField": "payload"
      }
    },
    {
      "name": "unisoc_file",
      "description": "文件分块传输帧 (照片/视频/OTA固件)",
      "endian": "little",
      "fields": [
        {
          "name": "start",
          "encoding": "hex",
          "byteLength": 1,
          "value": "0xF5"
        },
        {
          "name": "fileId",
          "encoding": "uint8",
          "byteLength": 1,
          "description": "文件会话ID"
        },
        {
          "name": "blockIndex",
          "encoding": "uint16",
          "byteLength": 2,
          "endian": "little",
          "description": "分块序号 (0-based)"
        },
        {
          "name": "totalBlocks",
          "encoding": "uint16",
          "byteLength": 2,
          "endian": "little",
          "description": "总分块数"
        },
        {
          "name": "dataLen",
          "encoding": "uint16",
          "byteLength": 2,
          "endian": "little",
          "description": "本块数据长度 (≤180字节以适配BLE MTU)"
        },
        {
          "name": "data",
          "encoding": "bytes",
          "byteLength": 0,
          "lengthSource": "dataLen",
          "description": "文件分块数据"
        },
        {
          "name": "crc16",
          "encoding": "uint16",
          "byteLength": 2,
          "endian": "little",
          "description": "CRC-16/CCITT"
        },
        {
          "name": "end",
          "encoding": "hex",
          "byteLength": 1,
          "value": "0xF6"
        }
      ],
      "checksum": {
        "type": "crc16_ccitt",
        "startField": "start",
        "endField": "data"
      }
    },
    {
      "name": "imu_stream",
      "description": "IMU数据流帧 (9轴传感器，高频率推送)",
      "endian": "little",
      "fields": [
        {
          "name": "start",
          "encoding": "hex",
          "byteLength": 1,
          "value": "0x55"
        },
        {
          "name": "timestamp",
          "encoding": "uint32",
          "byteLength": 4,
          "endian": "little",
          "description": "时间戳 (ms)"
        },
        {
          "name": "accX",
          "encoding": "uint16",
          "byteLength": 2,
          "endian": "little",
          "description": "加速度X (mg, int16)"
        },
        {
          "name": "accY",
          "encoding": "uint16",
          "byteLength": 2,
          "endian": "little",
          "description": "加速度Y (mg)"
        },
        {
          "name": "accZ",
          "encoding": "uint16",
          "byteLength": 2,
          "endian": "little",
          "description": "加速度Z (mg)"
        },
        {
          "name": "gyroX",
          "encoding": "uint16",
          "byteLength": 2,
          "endian": "little",
          "description": "陀螺仪X (0.1°/s, int16)"
        },
        {
          "name": "gyroY",
          "encoding": "uint16",
          "byteLength": 2,
          "endian": "little",
          "description": "陀螺仪Y (0.1°/s)"
        },
        {
          "name": "gyroZ",
          "encoding": "uint16",
          "byteLength": 2,
          "endian": "little",
          "description": "陀螺仪Z (0.1°/s)"
        },
        {
          "name": "magX",
          "encoding": "uint16",
          "byteLength": 2,
          "endian": "little",
          "description": "磁力计X (0.1μT)"
        },
        {
          "name": "magY",
          "encoding": "uint16",
          "byteLength": 2,
          "endian": "little",
          "description": "磁力计Y (0.1μT)"
        },
        {
          "name": "magZ",
          "encoding": "uint16",
          "byteLength": 2,
          "endian": "little",
          "description": "磁力计Z (0.1μT)"
        }
      ],
      "checksum": {
        "type": "sum8",
        "startField": "start",
        "endField": "magZ"
      }
    }
  ],
