  "frameFormats": [
    {
      "name": "smp",
      "description": "MCUmgr Simple Management Protocol 帧。SMP使用CBOR编码，包含操作类型(Group ID)、命令ID、序列号和CBOR负载。用于Nordic标准OTA升级(Image Upload/Erase/Boot/Set/Confirm)和设备管理(Reset/Echo/Stats)。",
      "endian": "little",
      "fields": [
        {
          "name": "op",
          "encoding": "uint8",
          "byteLength": 1,
          "description": "操作类型",
          "enumMap": {
            "0": "READ",
            "1": "READ_RESP",
            "2": "WRITE",
            "3": "WRITE_RESP",
            "4": "SEND_TX",
            "5": "SEND_TX_RESP",
            "6": "SEND_RX",
            "7": "SEND_RX_RESP",
            "8": "FREE"
          }
        },
        {
          "name": "flags",
          "encoding": "uint8",
          "byteLength": 1,
          "description": "标志位 (bit0 = 需要响应)"
        },
        {
          "name": "len",
          "encoding": "uint16",
          "byteLength": 2,
          "endian": "little",
          "description": "CBOR payload长度"
        },
        {
          "name": "groupId",
          "encoding": "uint16",
          "byteLength": 2,
          "endian": "little",
          "description": "管理组ID",
          "enumMap": {
            "0": "OS_MGMT",
            "1": "IMAGE_MGMT",
            "2": "STATISTICS_MGMT",
            "3": "SETTINGS_MGMT",
            "4": "LOG_MGMT",
            "5": "RUNTIME_TESTS_MGMT",
            "6": "SPLIT_MGMT",
            "7": "TEST_MGMT",
            "8": "MISC_MGMT",
            "63": "SHELL_MGMT",
            "64": "FS_MGMT",
            "65": "ZEPHYR_MGMT"
          }
        },
        {
          "name": "seqNum",
          "encoding": "uint8",
          "byteLength": 1,
          "description": "序列号 (匹配请求响应)"
        },
        {
          "name": "cborPayload",
          "encoding": "bytes",
          "byteLength": 0,
          "lengthSource": "len",
          "description": "CBOR编码负载 (含命令ID和参数)"
        }
      ]
    },
    {
      "name": "nus_data",
      "description": "Nordic UART Service 透明传输数据 (原始字节流，无帧头帧尾)",
      "endian": "little",
      "fields": [
        {
          "name": "data",
          "encoding": "bytes",
          "byteLength": 0,
          "description": "原始数据 (≤MTU-3字节，通常为20-509字节)"
        }
      ]
    }
  ],
